# Set these as Environment Variables in Render's dashboard
# (Service -> Environment -> Add Environment Variable).
# This file is just documentation — Spring Boot on Render does not read .env files.
#
# IMPORTANT: the values that used to be hardcoded in application.properties
# (DB password, Gmail app password, JWT secret) were REAL, LIVE credentials
# that were committed to a public GitHub repo. Rotate all of them before
# putting new values here:
#   - Aiven MySQL: reset the avnadmin password from the Aiven console
#   - Gmail: revoke the old App Password and generate a new one
#   - JWT_SECRET: generate a new random string, e.g. `openssl rand -base64 48`

# ---------- MySQL (Aiven) ----------
DB_URL=jdbc:mysql://<your-aiven-host>:<port>/defaultdb?ssl-mode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=<new-rotated-password>

# ---------- Gmail SMTP ----------
MAIL_USERNAME=<your-gmail-address>
MAIL_PASSWORD=<new-app-password>

# ---------- Google Sign-In ----------
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# ---------- JWT ----------
JWT_SECRET=<new-random-secret>
